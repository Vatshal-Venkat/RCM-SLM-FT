# Copy to backend/.env and adjust. Never commit real secrets.

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Rate limiting (requests per client per minute) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Local GGUF model (llama.cpp) ---
LLM_PROVIDER=local_gguf
MODEL_PATH=models/rcm_qwen3_1.7b_q4_k_m.gguf
LLM_LOAD_ON_STARTUP=true
LLM_N_CTX=4096
# Defaults to (logical cores - 2). Benchmark with your CPU: prompt processing dominates latency.
# LLM_N_THREADS=6
LLM_N_GPU_LAYERS=0
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.3
LLM_TOP_P=0.8
LLM_TOP_K=20
LLM_REPEAT_PENALTY=1.1
# Qwen3 reasoning mode. Off by default: ~400 extra tokens per answer on CPU.
LLM_ENABLE_THINKING=false

# --- Database (Phase 3) ---
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
